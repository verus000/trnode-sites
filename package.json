{
  "name": "trnode-tools",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 1234",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 1234",
    "test": "vitest run",
    "build:worker": "opennextjs-cloudflare build",
    "deploy:worker": "opennextjs-cloudflare deploy",
    "preview:worker": "opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "lucide-react": "1.31.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vitest": "4.0.18",
    "wrangler": "4.137.0"
  }
}
